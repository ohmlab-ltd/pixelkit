# Cloudflare R2 — image storage. Backend will refuse uploads + serves until set.
# Create an R2 API token at: dash.cloudflare.com → R2 → Manage API tokens
# Scope: Object Read & Write on this single bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional — how long presigned image URLs stay valid (seconds, default 3600)
# R2_PRESIGN_TTL=3600

# CORS on the bucket must allow GET from your frontend origin so the browser
# can follow the redirect cross-origin. In the Cloudflare dashboard set:
# [{"AllowedOrigins": ["http://localhost:3000", "https://your.app"],
#   "AllowedMethods": ["GET"], "AllowedHeaders": ["*"]}]

# ─── Pipelines ────────────────────────────────────────────────────────
# CSV of frontend origins allowed by the FastAPI CORS middleware.
# Include http://localhost:3000 here when running a local dev FE.
# FRONTEND_ORIGINS=https://www.pixelkit.ai,https://pixelkit.ai

# Disable the V2 VLM (Qwen3-VL) load — frees ~10 GB of VRAM. V2
# endpoints keep working but vlm_label / vlm_score come back null.
# Set this to "1" to run Pipeline Charlie alongside V2 on a single 24 GB
# card, since SAM3 alone needs the headroom.
# VLM_DISABLED=1

# Pipeline Charlie (SAM3) — gated on Hugging Face. Set HF_TOKEN to a
# token with access to facebook/sam3 (huggingface.co/settings/tokens).
# Override SAM3_MODEL_ID for community repackages. CHARLIE_DISABLED=1
# skips the SAM3 load entirely and makes /api/charlie/* return 503.
# HF_TOKEN=hf_xxx
# SAM3_MODEL_ID=facebook/sam3
# CHARLIE_DISABLED=1
