# PixelKit engine — portable build. Everything is optional; the engine runs
# with no env at all (workspace defaults to ~/PixelKit).

# Workspace folder — where all projects, datasets, images, annotations and
# model weights live. Also settable via the app config; env wins.
# PIXELKIT_WORKSPACE=~/PixelKit

# Hugging Face token with access to the gated facebook/sam3 repo
# (accept the license at huggingface.co/facebook/sam3 first).
# The setup UI (model-manager phase) stores this for you; env works too.
# HF_TOKEN=hf_xxx

# Override the SAM3 repo (e.g. a community repackage).
# SAM3_MODEL_ID=facebook/sam3

# Optional small VLM label-tiebreak (Qwen3-VL-2B fp16, ~4 GB VRAM).
# VLM_ENABLED=1
# VLM_MODEL=Qwen/Qwen3-VL-2B-Instruct

# Skip all model loading (dataset/annotation APIs stay fully live).
# PK_DISABLE_MODELS=1
# CHARLIE_DISABLED=1
