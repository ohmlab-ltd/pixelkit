# Engine settings, read from engine/.env, which overrides the environment.
# Copy this file there. Every setting is optional.

# Workspace folder. Also set under Settings, Workspace.
# PIXELKIT_WORKSPACE=~/PixelKit

# Hugging Face token with access to facebook/sam3, used when the app has
# none stored.
# HF_TOKEN=hf_xxx

# Another repository with the SAM 3 weights.
# SAM3_MODEL_ID=facebook/sam3

# No models; every dataset, annotation and export API still works.
# PK_DISABLE_MODELS=1
# No SAM 3; DINOv2 still loads.
# CHARLIE_DISABLED=1

# Device: cuda, cuda:N, mps or cpu. Default: cuda, then mps, then cpu.
# On cpu the models load and labelling takes minutes per image.
# PK_DEVICE=cpu
