{
  "name": "pixelkit-desktop",
  "productName": "PixelKit",
  "version": "0.1.0",
  "description": "PixelKit desktop shell (Electron wrapper around the local PixelKit engine)",
  "private": true,
  "main": "main.js",
  "author": "Ohm Lab <team@ohmlab.co.uk>",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icon": "node -e \"require('sharp')('../ui/public/pixelkit-favicon.svg',{density:512}).resize(1024,1024,{fit:'contain',background:{r:0,g:0,b:0,alpha:0}}).png().toFile('build/icon.png')\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "co.ohmlab.pixelkit",
    "productName": "PixelKit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "bootstrap.js",
      "updater.js",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "extraResources": [
        {
          "from": "runtime",
          "to": "runtime"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PixelKit-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "../engine/gd",
        "to": "engine/gd",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../engine/requirements-win.txt",
        "to": "engine/requirements-win.txt"
      },
      {
        "from": "../ui/out",
        "to": "ui"
      }
    ]
  }
}