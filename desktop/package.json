{
  "name": "pixelkit-desktop",
  "productName": "PixelKit",
  "version": "0.4.1",
  "description": "PixelKit desktop shell (Electron wrapper around the local PixelKit engine)",
  "private": true,
  "main": "main.js",
  "author": "Ohm Lab <team@ohmlab.co.uk>",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icon": "node -e \"require('sharp')('../ui/public/pixelkit-favicon.svg',{density:512}).resize(1024,1024,{fit:'contain',background:{r:0,g:0,b:0,alpha:0}}).png().toFile('build/icon.png')\""
  },
  "devDependencies": {
    "electron": "^43.7.9",
    "electron-builder": "^26.17.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "co.ohmlab.pixelkit",
    "productName": "PixelKit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "bootstrap.js",
      "updater.js",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "PixelKit-arm64.dmg",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "runtime",
          "to": "runtime"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PixelKit-Setup.exe",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "../engine/gd",
        "to": "engine/gd",
        "filter": [
          "**/*.py",
          "**/LICENSE"
        ]
      },
      {
        "from": "../engine/requirements-win.txt",
        "to": "engine/requirements-win.txt"
      },
      {
        "from": "../engine/requirements-win-torch-cuda.txt",
        "to": "engine/requirements-win-torch-cuda.txt"
      },
      {
        "from": "../engine/requirements-win-torch-cpu.txt",
        "to": "engine/requirements-win-torch-cpu.txt"
      },
      {
        "from": "../engine/import_legacy.py",
        "to": "engine/import_legacy.py"
      },
      {
        "from": "../ui/out",
        "to": "ui"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../ui/app/fonts/OFL.txt",
        "to": "licenses/Geist-OFL.txt"
      }
    ]
  }
}
